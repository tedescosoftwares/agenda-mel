# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Google Maps (2.82.1): o mapa do pino e a busca de endereço. Chave de
# API restrita aos domínios do site e às APIs "Maps JavaScript" e
# "Geocoding". Sem ela, o app usa OpenStreetMap (Leaflet + Nominatim).
VITE_GOOGLE_MAPS_KEY=
