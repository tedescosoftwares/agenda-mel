# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# variáveis de ambiente
.env

# o último sitemap avisado ao Bing (IndexNow, 3.21): estado da máquina, não código
evolution/indexnow-ultimo.xml
# o cache do guia por cidade (3.23): o gerador guarda o que já leu do banco
.cache/

# sites de parceiros: configuracao vive so na VPS
evolution/sites/*.caddy

# App da loja (Expo): apps/mobile tem o próprio .gitignore (node_modules, .expo, dist,
# android/ e ios/ gerados, keystores). Aqui só o que não pode subir de jeito nenhum.
apps/mobile/.env
apps/mobile/*.keystore
apps/mobile/*.jks

# guia de salões: o que o script do Maps grava na máquina de quem roda (tem a nota do Google)
scripts/guia/mimo_*
scripts/guia/__pycache__/

# worktrees temporários das ferramentas de agente (não vão para o repositório)
.claude/worktrees/
# 3.40: o guia no ar guardado durante o build (publicar-site.sh)
.guia-anterior/
# 3.41: a versão que o banco já tem como publicada (republicar-se-mudou.sh e publicar-site.sh, no VPS)
evolution/.publicacao-registrada
