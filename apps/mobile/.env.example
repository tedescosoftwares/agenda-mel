# Copie para .env (o .env fica fora do git). São os mesmos valores do .env da
# web (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY): o app fala com o mesmo banco.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Onde a web mora: a ponte (src/app/web.tsx) abre as telas daqui. Em
# desenvolvimento pode apontar para o PC, com a web rodando `npm run dev -- --host`
# na raiz do repo: EXPO_PUBLIC_WEB_URL=http://192.168.0.10:5173
EXPO_PUBLIC_WEB_URL=https://mimo.com.vc
