{
  "expo": {
    "name": "MIMO",
    "slug": "mimo",
    "version": "3.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "scheme": "mimo",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/cliente/icone.png",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "A MIMO usa suas fotos só para a foto do seu perfil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A MIMO usa a câmera só para ler o QR da sua profissional."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A MIMO usa sua localização só para mostrar os salões, promoções e ofertas perto de você."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/cliente/icone.png"
    },
    "extra": {
      "variante": "cliente",
      "host": "mimo.com.vc",
      "versao": "3.64.1",
      "router": {},
      "eas": {
        "projectId": "68ce294b-1e25-49a4-b0f4-b93ff4d71a28"
      }
    },
    "owner": "brunotedesco"
  }
}
