{
  "cli": {
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "cliente" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "cliente" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "APP_VARIANT": "cliente" }
    },
    "pro-preview": {
      "extends": "preview",
      "env": { "APP_VARIANT": "pro" }
    },
    "pro-production": {
      "extends": "production",
      "env": { "APP_VARIANT": "pro" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    },
    "pro-production": {
      "android": { "track": "internal" }
    }
  }
}
