{
  "cli": {
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "cliente"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "cliente"
      },
      "channel": "preview",
      "environment": "production"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "cliente"
      },
      "channel": "production"
    },
    "pro-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "pro"
      },
      "channel": "pro-preview"
    },
    "pro-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "pro"
      },
      "channel": "pro-production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    },
    "pro-production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
