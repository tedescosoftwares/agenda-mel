# Domínio que aponta para o IP desta máquina.
# Não tem domínio? Pegue um grátis no duckdns.org (leva 2 minutos) e
# use algo como agendamel.duckdns.org — funciona com Let's Encrypt.
DOMINIO=agendamel.duckdns.org

# E-mail para a Let's Encrypt avisar sobre o certificado
EMAIL=voce@email.com

# Invente uma chave longa. É a senha da sua Evolution: quem tiver ela
# manda mensagem pelo seu WhatsApp. Gere com:  openssl rand -hex 32
API_KEY=troque-por-uma-chave-longa-de-verdade

# Senha do Postgres interno (não é usada fora dos containers)
POSTGRES_SENHA=troque-tambem

# ---------------------------------------------------------------
# Modelo de linguagem local (opcional — só se você rodar o subir-ia.sh)
# ---------------------------------------------------------------

# Senha da rota /ia. Sem isso a rota devolve 401 para todo mundo,
# que é o certo enquanto você não estiver usando.  openssl rand -hex 32
IA_TOKEN=

# Qual modelo o subir-ia.sh vai baixar. Deixe vazio para ele escolher
# sozinho conforme a RAM da máquina. Veja a tabela no LEIAME.
IA_MODELO=
