# HTTPS automático: o Caddy pede o certificado à Let's Encrypt na
# primeira subida e renova sozinho. Só precisa que o domínio aponte
# para o IP desta máquina e que as portas 80 e 443 estejam abertas.

{$DOMINIO} {
	tls {$EMAIL}

	# o painel da Evolution, para escanear o QR code pelo navegador
	handle /manager* {
		reverse_proxy evolution:8080
	}

	# o modelo local, quando estiver no ar (docker compose --profile ia up -d).
	#
	# O Ollama não tem autenticação nenhuma: quem chega na porta manda
	# o que quiser. Por isso o token é conferido aqui, antes de repassar.
	# NUNCA esvazie o IA_TOKEN com o modelo no ar: com token vazio a
	# comparação vira "Bearer " e qualquer um passa. Para desligar,
	# derrube o container:  docker compose --profile ia down
	handle /ia/* {
		@sem_token {
			not header Authorization "Bearer {$IA_TOKEN}"
		}
		respond @sem_token "não autorizado" 401

		# /ia/api/chat  ->  ollama:11434/api/chat
		uri strip_prefix /ia
		reverse_proxy ollama:11434 {
			# geração em CPU é lenta: o padrão de 5 min do Caddy
			# cortaria a resposta no meio numa máquina pequena
			transport http {
				response_header_timeout 10m
			}
		}
	}

	handle {
		reverse_proxy evolution:8080
	}

	encode gzip

	log {
		output file /data/acesso.log
		format json
	}
}


# ---------------------------------------------------------------
# O SITE, na mesma máquina.
#
# O app é estático (Vite gera dist/), então não precisa de servidor
# próprio: o Caddy entrega os arquivos e, para qualquer rota que não
# seja arquivo, devolve o index.html — é assim que /cliente/home
# funciona ao abrir direto pela URL.
#
# Só entra no ar quando DOMINIO_SITE está no .env. Sem ele, o bloco
# responde em "localhost", ou seja, para ninguém.
# ---------------------------------------------------------------
{$DOMINIO_SITE:localhost} {
	tls {$EMAIL}
	root * /srv/site
	encode gzip

	# o service worker nunca pode ser cacheado, senão a pessoa fica
	# presa numa versão velha do app
	@sw path /sw.js
	header @sw Cache-Control "no-cache, must-revalidate"

	# o resto do bundle tem hash no nome: pode viver um ano no cache
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Prévia bonita no WhatsApp e no Instagram. Os robôs que montam a
	# prévia de um link não rodam JavaScript: para eles, /p/<slug> vai
	# buscar numa função do Supabase um HTML pequeno com a foto, o nome
	# e a nota da profissional nas etiquetas Open Graph. Gente de
	# verdade nunca cai aqui — recebe o app, como sempre.
	@robos_no_link {
		path /p/*
		header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview|iframely|embedly|googlebot|bingbot)
	}
	handle @robos_no_link {
		rewrite * /functions/v1/pagina-publica{path}
		reverse_proxy https://{$SUPABASE_REF:nenhum}.supabase.co {
			header_up Host {upstream_hostport}
		}
	}

	try_files {path} /index.html
	file_server

	log {
		output file /data/site.log
		format json
	}
}


# ---------------------------------------------------------------
# OUTROS SITES NA MESMA MÁQUINA (parceiros, domínios extras).
#
# Cada um é um arquivo em evolution/sites/<nome>.caddy, que fica só
# na VPS (a pasta é ignorada pelo git): assim um git pull nunca apaga
# o site de ninguém, e este Caddyfile não precisa mudar. Os arquivos
# estáticos de cada site moram em /home/ubuntu/sites/<nome>, que o
# container enxerga como /srv/sites/<nome>.
#
# Exemplo, evolution/sites/nutrimilia.caddy:
#
#   nutrimilia.com, www.nutrimilia.com {
#   	tls {$EMAIL}
#   	root * /srv/sites/nutrimilia
#   	encode gzip
#   	try_files {path} /index.html
#   	file_server
#   }
#
# Depois: docker compose up -d caddy
# ---------------------------------------------------------------
import /etc/caddy/sites/*.caddy
